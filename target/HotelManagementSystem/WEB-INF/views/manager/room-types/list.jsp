<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý loại phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817"></head>
<body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><p class="eyebrow">UC60 · UC61 · UC63</p><h1>Loại phòng &amp; tiện nghi</h1><p>Cấu hình sức chứa, giường, tiện nghi, giá cơ bản và trạng thái bán.</p></div><a class="primary" href="${pageContext.request.contextPath}/manager/room-types/create"><span class="material-symbols-outlined">add</span>Tạo loại phòng</a></div>
<c:if test="${not empty sessionScope.flash}"><p class="alert success"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if>
<section class="panel search-panel"><form class="filters" method="get"><label class="grow">Tìm kiếm<input name="keyword" value="<c:out value='${criteria.keyword}'/>" placeholder="Mã hoặc tên loại phòng"></label><label>Trạng thái<select name="active"><option value="">Tất cả</option><option value="true" ${criteria.active==true?'selected':''}>Đang bán</option><option value="false" ${criteria.active==false?'selected':''}>Ngừng bán</option></select></label><button class="primary" type="submit">Lọc</button></form></section>
<section class="panel table-panel"><div class="panel-title"><div><h2>Danh mục loại phòng</h2><p>${result.totalItems} kết quả</p></div><span class="count-badge">Trang ${result.page}/${result.totalPages()}</span></div>
<c:choose><c:when test="${empty result.items}"><div class="empty-state"><span class="material-symbols-outlined">bedroom_parent</span><h3>Chưa có loại phòng</h3><p>Tạo loại phòng đầu tiên để bắt đầu cấu hình kho phòng.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Mã / tên</th><th>Sức chứa</th><th>Giường</th><th>Giá cơ bản</th><th>Tiện nghi</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${result.items}" var="item"><tr><td><strong><c:out value="${item.typeCode}"/></strong><small class="subtext"><c:out value="${item.typeName}"/></small></td><td>${item.maxAdults} người lớn · ${item.maxChildren} trẻ em</td><td><c:out value="${item.bedType}"/></td><td>${item.basePrice}</td><td><c:out value="${item.amenities}"/></td><td><span class="status ${item.active?'success':'muted'}">${item.active?'ACTIVE':'INACTIVE'}</span></td><td><a class="table-link" href="${pageContext.request.contextPath}/manager/room-types/view?id=${item.id}">Chi tiết</a><a class="table-link" href="${pageContext.request.contextPath}/manager/room-types/edit?id=${item.id}">Sửa</a></td></tr></c:forEach></tbody></table></div><nav class="pagination"><c:if test="${result.page>1}"><a href="?keyword=${criteria.keyword}&active=${criteria.active}&page=${result.page-1}">‹ Trước</a></c:if><span>Trang ${result.page} / ${result.totalPages()}</span><c:if test="${result.page<result.totalPages()}"><a href="?keyword=${criteria.keyword}&active=${criteria.active}&page=${result.page+1}">Sau ›</a></c:if></nav></c:otherwise></c:choose></section>
</div></main></div></body></html>
