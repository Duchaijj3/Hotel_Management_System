<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>${mode=='create'?'Tạo':'Sửa'} phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content narrow-content">
<a class="back-link" href="${pageContext.request.contextPath}/manager/rooms">← Danh sách phòng</a><div class="page-heading"><div><h1>${mode=='create'?'Tạo phòng':'Cập nhật phòng'}</h1><p>Không thay đổi trạng thái vệ sinh tại màn hình Manager.</p></div></div><c:if test="${not empty errors.general}"><p class="alert error"><c:out value="${errors.general}"/></p></c:if>
<form class="panel form-panel" method="post"><c:if test="${mode=='edit'}"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="version" value="${item.updatedAt}"></c:if><div class="form-grid"><label>Số phòng *<input name="roomNumber" maxlength="20" required value="<c:out value='${item.roomNumber}'/>"><span class="field-error"><c:out value="${errors.roomNumber}"/></span></label><label>Loại phòng *<select name="roomTypeId" required><option value="">Chọn loại phòng</option><c:forEach items="${roomTypes}" var="type"><option value="${type.id}" ${item.roomTypeId==type.id?'selected':''}><c:out value="${type.typeCode}"/> · <c:out value="${type.typeName}"/></option></c:forEach></select><span class="field-error"><c:out value="${errors.roomTypeId}"/></span></label><label>Tầng<input type="number" name="floorNumber" value="${item.floorNumber}"></label><label>Trạng thái vận hành<select name="operationalStatus"><option ${item.operationalStatus=='AVAILABLE'?'selected':''}>AVAILABLE</option><option ${item.operationalStatus=='OCCUPIED'?'selected':''}>OCCUPIED</option><option ${item.operationalStatus=='MAINTENANCE'?'selected':''}>MAINTENANCE</option><option ${item.operationalStatus=='OUT_OF_SERVICE'?'selected':''}>OUT_OF_SERVICE</option></select><span class="field-error"><c:out value="${errors.operationalStatus}"/></span></label><label class="checkbox-field"><input type="checkbox" name="active" ${item.active?'checked':''}> Phòng đang được kích hoạt</label><label class="span-2">Ghi chú<textarea name="notes" maxlength="500"><c:out value="${item.notes}"/></textarea></label></div><div class="form-actions"><a class="secondary-button" href="${pageContext.request.contextPath}/manager/rooms">Hủy</a><button class="primary" type="submit">Lưu phòng</button></div></form>
</div></main></div></body></html>
