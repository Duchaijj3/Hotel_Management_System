<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="activePage" value="checkin"/><c:set var="moduleCode" value="UC28–UC30"/><c:set var="pageTitle" value="Check-in"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Nhận phòng — LuxeStay HMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260820"></head><body><div class="app-shell"><%@ include file="fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><h1>Nhận phòng cho khách</h1><p>Tìm đặt phòng, xác minh giấy tờ và hoàn tất nhận phòng.</p></div></div>
<section class="panel search-panel"><div class="panel-title"><div><h2>Tìm kiếm đặt phòng</h2><p>Có thể tìm bằng tên, số điện thoại, email, CCCD hoặc hộ chiếu.</p></div></div><form class="filters" method="get" style="padding-top:16px"><label class="grow">Thông tin khách hàng<input name="keyword" maxlength="100" value="<c:out value='${param.keyword}'/>" placeholder="Nhập tên, số điện thoại, email hoặc giấy tờ..." required></label><button class="primary" type="submit"><span class="material-symbols-outlined">search</span>Tìm kiếm</button></form></section>
<c:if test="${not empty param.keyword}"><section class="panel table-panel"><div class="panel-title"><div><h2>Kết quả đặt phòng</h2><p>Chọn đúng đặt phòng để tiếp tục nhận phòng.</p></div><span class="count-badge">${reservations.size()} kết quả</span></div><c:choose><c:when test="${empty reservations}"><div class="empty-state"><h3>Không tìm thấy đặt phòng phù hợp</h3></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Mã đặt phòng</th><th>Khách đứng tên</th><th>Liên hệ</th><th>Thời gian lưu trú</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach items="${reservations}" var="r"><tr><td><strong class="code"><c:out value="${r.bookingCode}"/></strong></td><td><c:out value="${r.customerName}"/></td><td class="contact-cell"><c:out value="${r.phone}"/><small><c:out value="${r.email}"/></small></td><td>${r.checkInDate} → ${r.checkOutDate}</td><td><span class="status ${r.statusCode=='CONFIRMED'?'success':'muted'}"><c:out value="${r.statusCode}"/></span></td><td><a class="primary" href="?identifier=${r.reservationId}">Chọn đặt phòng</a></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section></c:if>
<c:if test="${not empty success}"><p class="alert success"><c:out value="${success}"/></p></c:if><c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if>
<c:if test="${not empty details}"><form method="post"><input type="hidden" name="reservationId" value="${details.reservationId}">
<div class="detail-grid"><section class="panel"><div class="panel-title"><div><h2>Identity Verification</h2><p>Đối chiếu giấy tờ bản gốc của khách lưu trú.</p></div><span class="material-symbols-outlined">badge</span></div><c:choose><c:when test="${empty details.stayingGuests}"><div class="empty-state compact"><span class="material-symbols-outlined">person_off</span><h3>Booking chưa có khách lưu trú</h3></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Khách</th><th>Ngày sinh</th><th>Loại giấy tờ</th><th>Số giấy tờ</th><th>Quốc tịch</th></tr></thead><tbody><c:forEach items="${details.stayingGuests}" var="g"><tr><td><div class="guest-cell"><span class="guest-avatar">${g.fullName.substring(0,1)}</span><div><strong><c:out value="${g.fullName}"/></strong><small>${g.primary?'PRIMARY GUEST':'STAYING GUEST'}</small></div></div></td><td><c:out value="${g.dateOfBirth}"/></td><td><c:out value="${g.documentType}"/></td><td><c:out value="${g.documentNumber}"/></td><td><c:out value="${g.nationality}"/></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
<section class="panel"><div class="panel-title"><div><h2>Stay Details</h2><p>Conf: <c:out value="${details.bookingCode}"/></p></div><span class="status success"><c:out value="${details.statusCode}"/></span></div><dl class="info-list"><dt>Booking Holder</dt><dd><c:out value="${details.bookingHolderName}"/></dd><dt>Check-in</dt><dd>${details.checkInDate}</dd><dt>Check-out</dt><dd>${details.checkOutDate}</dd><dt>Deposit</dt><dd>${details.depositPaid} / ${details.depositRequired}</dd><dt>Còn thiếu</dt><dd>${details.remainingDeposit}</dd></dl></section></div>
<section class="panel table-panel"><div class="panel-title"><div><h2>Room Details</h2><p>Chọn đúng số phòng AVAILABLE + INSPECTED cho từng loại phòng.</p></div><span class="material-symbols-outlined">king_bed</span></div><c:forEach items="${details.roomSelections}" var="rr"><div class="selection-block"><h3><c:out value="${rr.roomTypeName}"/> — chọn ${rr.requiredQuantity} phòng <small>(reservation room #${rr.reservationRoomId})</small></h3><c:choose><c:when test="${empty rr.availableRooms}"><p class="alert error" style="margin:16px 24px">Không có phòng đã kiểm tra và sẵn sàng.</p></c:when><c:otherwise><div class="room-grid"><c:forEach items="${rr.availableRooms}" var="room"><label class="room-card selectable"><input type="checkbox" name="room_${rr.reservationRoomId}" value="${room.roomId}" <c:if test="${not empty selectedRooms[rr.reservationRoomId] and selectedRooms[rr.reservationRoomId].contains(room.roomId)}">checked</c:if>><div class="room-number"><span class="material-symbols-outlined">bed</span><div><small>ROOM</small><strong><c:out value="${room.roomNumber}"/></strong></div></div><dl><dt>Tầng</dt><dd>${room.floor}</dd><dt>Vận hành</dt><dd><c:out value="${room.operationalStatus}"/></dd><dt>Vệ sinh</dt><dd>INSPECTED</dd></dl></label></c:forEach></div></c:otherwise></c:choose></div></c:forEach></section>
<section class="panel form-panel"><label class="confirm-line"><input type="checkbox" name="documentsChecked" required ${documentsChecked?'checked':''}> Tôi đã trực tiếp xác minh giấy tờ tùy thân bản gốc.</label><div class="alert"><strong>Incidentals Deposit:</strong> ${details.remainingDeposit} còn cần xử lý. Khi hoàn tất, hệ thống sẽ cấp phòng và tạo hóa đơn nháp trong cùng giao dịch.</div><button class="primary wide" type="submit" ${details.statusCode!='CONFIRMED'?'disabled':''}><span class="material-symbols-outlined">done_all</span>Complete Check-in</button></section>
</form></c:if>
</div></main></div></body></html>
