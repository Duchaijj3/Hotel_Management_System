<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="activePage" value="checkin"/><c:set var="moduleCode" value="UC30"/><c:set var="pageTitle" value="Chọn phòng cho check-in"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chọn phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content"><div class="page-heading"><div><p class="eyebrow">UC30 • ROOM SELECTION</p><h1>Phòng phù hợp cho booking</h1><p>Đây là màn hình chỉ đọc. Assignment chỉ được lưu khi xác nhận UC28 Check-in.</p></div><a class="primary" href="${pageContext.request.contextPath}/receptionist/check-in?identifier=${page.target.reservationId}">Quay lại Check-in</a></div><section class="panel form-panel"><dl class="info-list"><dt>Booking code</dt><dd><c:out value="${page.target.bookingCode}"/></dd><dt>Booking Holder</dt><dd><c:out value="${page.target.customerName}"/></dd><dt>Loại phòng</dt><dd><c:out value="${page.target.roomTypeName}"/></dd><dt>Yêu cầu</dt><dd>${page.target.quantity} phòng</dd><dt>Thời gian</dt><dd>${page.target.checkInDate} → ${page.target.checkOutDate}</dd></dl></section><section class="panel table-panel"><div class="panel-title"><h2>AVAILABLE + INSPECTED</h2><span class="count-badge">${page.rooms.size()} phòng</span></div><c:choose><c:when test="${empty page.rooms}"><div class="empty-state"><h3>Không có phòng sẵn sàng</h3></div></c:when><c:otherwise><div class="room-grid"><c:forEach items="${page.rooms}" var="r"><article class="room-card"><div class="room-number"><span>⌂</span><div><small>PHÒNG</small><strong><c:out value="${r.roomNumber}"/></strong></div></div><dl><dt>Tầng</dt><dd>${r.floor}</dd><dt>Vận hành</dt><dd><c:out value="${r.operationalStatus}"/></dd><dt>Vệ sinh</dt><dd>Ready (INSPECTED)</dd></dl></article></c:forEach></div></c:otherwise></c:choose></section></div></main></div></body></html>
