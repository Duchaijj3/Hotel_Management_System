<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="activePage" value="rooms"/><c:set var="moduleCode" value="UC29"/><c:set var="pageTitle" value="Tìm phòng trống"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Tìm phòng trống — LuxeStay HMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260821"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><h1>Tìm phòng trống</h1><p>Nhập nhu cầu lưu trú để tìm các phòng đang sẵn sàng và đủ sức chứa.</p></div></div>
<section class="panel form-panel"><form method="get"><div class="form-grid"><label>Ngày nhận phòng<input type="date" name="checkIn" value="<c:out value='${param.checkIn}'/>" required></label><label>Ngày trả phòng<input type="date" name="checkOut" value="<c:out value='${param.checkOut}'/>" required></label><label>Loại phòng<select name="roomTypeId"><option value="">Tất cả loại phòng</option><c:forEach items="${roomTypes}" var="t"><option value="${t.roomTypeId}" ${param.roomTypeId==t.roomTypeId.toString()?'selected':''}><c:out value="${t.typeName}"/> — tối đa ${t.maxAdults} người lớn, ${t.maxChildren} trẻ em</option></c:forEach></select></label><label>Tầng mong muốn<input type="number" name="floor" value="<c:out value='${param.floor}'/>" placeholder="Để trống nếu không yêu cầu"></label><label>Số người lớn<input type="number" name="adults" min="1" max="20" value="${empty param.adults?1:param.adults}" required></label><label>Số trẻ em<input type="number" name="children" min="0" max="20" value="${empty param.children?0:param.children}" required></label></div><button class="primary wide" type="submit"><span class="material-symbols-outlined">search</span>Tìm kiếm phòng trống</button></form></section>
<c:if test="${not empty lookupError}"><p class="alert error"><c:out value="${lookupError}"/></p></c:if>
<c:if test="${searched}"><section class="panel table-panel"><div class="panel-title"><div><h2>Phòng phù hợp</h2><p>${param.checkIn} → ${param.checkOut} • ${param.adults} người lớn • ${param.children} trẻ em</p></div><span class="count-badge">${rooms.size()} phòng</span></div><c:choose><c:when test="${empty rooms}"><div class="empty-state"><span class="material-symbols-outlined">bedroom_parent</span><h3>Không có phòng phù hợp</h3><p>Hãy thử thay đổi loại phòng, tầng hoặc số lượng khách.</p></div></c:when><c:otherwise><div class="room-grid"><c:forEach items="${rooms}" var="r"><article class="room-card"><div class="room-number"><span class="material-symbols-outlined">bed</span><div><small>PHÒNG</small><strong><c:out value="${r.roomNumber}"/></strong></div></div><dl><dt>Loại phòng</dt><dd><c:out value="${r.typeName}"/></dd><dt>Tầng</dt><dd>${r.floor}</dd><dt>Giường</dt><dd><c:out value="${r.bedType}"/></dd><dt>Sức chứa</dt><dd>${r.maxAdults} người lớn, ${r.maxChildren} trẻ em</dd><dt>Trạng thái</dt><dd>Sẵn sàng</dd></dl></article></c:forEach></div></c:otherwise></c:choose></section></c:if>
</div></main></div></body></html>
