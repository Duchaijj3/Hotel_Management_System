<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="activePage" value="history"/><c:set var="moduleCode" value="UC31"/><c:set var="pageTitle" value="Đổi phòng vật lý"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Đổi phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content narrow-content"><div class="page-heading"><div><p class="eyebrow">UC31 • CHANGE PHYSICAL ROOM</p><h1>Đổi phòng cho booking</h1><p>Thay phòng vật lý của reservation room; không chuyển một guest cụ thể.</p></div></div><c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if><section class="panel form-panel"><dl class="info-list"><dt>Booking code</dt><dd><c:out value="${details.bookingCode}"/></dd><dt>Booking Holder</dt><dd><c:out value="${details.bookingHolderName}"/></dd><dt>Trạng thái booking</dt><dd><c:out value="${details.reservationStatus}"/></dd><dt>Thời gian lưu trú</dt><dd>${details.checkInDate} → ${details.checkOutDate}</dd><dt>Loại phòng</dt><dd><c:out value="${details.roomTypeName}"/></dd><dt>Phòng hiện tại</dt><dd><c:out value="${details.oldRoomNumber}"/> — tầng ${details.oldFloor}</dd><dt>Được gán lúc</dt><dd><c:out value="${details.assignedAt}"/></dd></dl><form method="post"><input type="hidden" name="assignmentId" value="${details.roomAssignmentId}"><input type="hidden" name="bookingCode" value="${details.bookingCode}"><div class="form-grid"><label>Phòng mới<select name="newRoomId" required><option value="">Chọn AVAILABLE + INSPECTED</option><c:forEach items="${rooms}" var="r"><option value="${r.roomId}"><c:out value="${r.roomNumber}"/> — tầng ${r.floor} — Ready</option></c:forEach></select></label><label>Lý do đổi phòng<textarea name="reason" maxlength="255" required></textarea></label></div><button class="primary wide" type="submit" ${empty rooms?'disabled':''}>Xác nhận đổi phòng</button></form></section></div></main></div></body></html>
