<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="activePage" value="history"/><c:set var="moduleCode" value="UC32"/><c:set var="pageTitle" value="Lịch sử gán phòng"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Lịch sử gán phòng — LuxeStay HMS</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260820"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><h1>Lịch sử gán phòng</h1><p>Hiển thị 100 lần gán hoặc đổi phòng gần nhất. Sử dụng tìm kiếm khi cần thu hẹp kết quả.</p></div></div>
<section class="panel search-panel"><form class="filters" method="get"><label class="grow">Tìm trong lịch sử<input name="keyword" maxlength="100" value="<c:out value='${param.keyword}'/>" placeholder="Tên khách, mã đặt phòng, số điện thoại hoặc số phòng..."></label><button class="primary" type="submit"><span class="material-symbols-outlined">search</span>Tìm kiếm</button><a class="secondary-button" href="${pageContext.request.contextPath}/receptionist/assignments/history">Xóa bộ lọc</a></form></section>
<c:if test="${not empty success}"><p class="alert success"><c:out value="${success}"/></p></c:if><c:if test="${not empty error}"><p class="alert error"><c:out value="${error}"/></p></c:if>
<section class="panel table-panel"><div class="panel-title"><div><h2>Danh sách lịch sử</h2><p>Sắp xếp từ mới nhất đến cũ nhất.</p></div><span class="count-badge">${history.size()} bản ghi</span></div><c:choose><c:when test="${empty history}"><div class="empty-state"><span class="material-symbols-outlined">history</span><h3>Chưa có lịch sử phù hợp</h3></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Mã đặt phòng</th><th>Khách đứng tên</th><th>Loại phòng</th><th>Phòng / Tầng</th><th>Thời điểm gán</th><th>Nhân viên</th><th>Thời điểm kết thúc</th><th>Lý do</th><th>Trạng thái</th><th></th></tr></thead><tbody><c:forEach items="${history}" var="x"><tr><td><strong class="code"><c:out value="${x.bookingCode}"/></strong></td><td><c:out value="${x.bookingHolderName}"/></td><td><c:out value="${x.roomTypeName}"/></td><td><c:out value="${x.roomNumber}"/> / ${x.floor}</td><td><c:out value="${x.assignedAt}"/></td><td><c:out value="${x.assignedBy}"/></td><td><c:out value="${x.unassignedAt}"/></td><td><c:out value="${x.unassignedReason}"/></td><td><span class="status ${x.current?'success':'muted'}">${x.current?'Hiện tại':'Đã kết thúc'}</span></td><td><c:if test="${x.current}"><a class="table-link" href="${pageContext.request.contextPath}/receptionist/rooms/change?assignmentId=${x.assignmentId}">Đổi phòng</a></c:if></td></tr></c:forEach></tbody></table></div></c:otherwise></c:choose></section>
</div></main></div></body></html>
