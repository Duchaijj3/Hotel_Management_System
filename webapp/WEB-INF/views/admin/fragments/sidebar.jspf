<%@ page pageEncoding="UTF-8" %>
<aside class="sidebar admin-sidebar">
    <div class="staff-card">
        <span class="avatar">AD</span>
        <span class="staff-copy"><strong>Administrator</strong><small><c:out value="${sessionScope.sessionUser.fullName}"/></small></span>
    </div>
    <nav class="side-nav" aria-label="Điều hướng Admin">
        <p class="nav-label">ADMIN</p>
        <a class="${activePage=='dashboard'?'active':''}" href="${pageContext.request.contextPath}/admin/dashboard"><span class="material-symbols-outlined" aria-hidden="true">dashboard</span>Tổng quan</a>
        <p class="nav-label">ACCOUNTS</p>
        <a class="${activePage=='users'?'active':''}" href="${pageContext.request.contextPath}/admin/users"><span class="material-symbols-outlined" aria-hidden="true">manage_accounts</span>Quản lý tài khoản</a>
        <p class="nav-label">SYSTEM &amp; EMAIL</p>
        <a class="${activePage=='email-templates'?'active':''}" href="${pageContext.request.contextPath}/admin/email-templates"><span class="material-symbols-outlined" aria-hidden="true">mail</span>Mẫu email thông báo</a>
        <a class="${activePage=='email-deliveries'?'active':''}" href="${pageContext.request.contextPath}/admin/email-deliveries"><span class="material-symbols-outlined" aria-hidden="true">mark_email_read</span>Nhật ký gửi email</a>
        <p class="nav-label">ACCOUNT SETTINGS</p>
        <a class="${activePage=='profile'?'active':''}" href="${pageContext.request.contextPath}/admin/profile"><span class="material-symbols-outlined" aria-hidden="true">account_circle</span>Trang cá nhân</a>
    </nav>
</aside>
