<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý giá phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817-2"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><p class="eyebrow">UC64</p><h1>Giá phòng theo ngày</h1><p>Giá theo ngày ưu tiên hơn giá cơ bản; stop-sell đóng bán trong ngày tương ứng.</p></div></div><c:if test="${not empty sessionScope.flash}"><p class="alert success"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if>
<div class="pricing-layout"><section class="panel form-panel"><div class="panel-title"><h2>Thiết lập khoảng giá</h2></div><c:if test="${not empty errors.dateRange}"><p class="alert error"><c:out value="${errors.dateRange}"/></p></c:if><form class="stack-form" method="post" action="${pageContext.request.contextPath}/manager/pricing"><label>Loại phòng *<select name="rateRoomTypeId" required><option value="">Chọn loại phòng</option><c:forEach items="${roomTypes}" var="type"><option value="${type.id}" ${rateForm.roomTypeId==type.id?'selected':''}><c:out value="${type.typeName}"/> · Base ${type.basePrice}</option></c:forEach></select><span class="field-error"><c:out value="${errors.roomTypeId}"/></span></label><div class="form-grid compact-grid"><label>Từ ngày *<input type="date" name="rateStartDate" required value="${rateForm.startDate}"></label><label>Đến ngày *<input type="date" name="rateEndDate" required value="${rateForm.endDate}"></label></div><label>Giá mỗi đêm *<input type="number" min="0" step="0.01" name="rateNightlyPrice" required value="${rateForm.nightlyPrice}"><span class="field-error"><c:out value="${errors.nightlyPrice}"/></span><span class="subtext">Giá đã tồn tại trong khoảng ngày sẽ được ghi đè.</span></label><label class="checkbox-field"><input type="checkbox" name="rateStopSell" ${rateForm.stopSell?'checked':''}> Stop-sell trong toàn bộ khoảng ngày</label><button class="primary wide" type="submit">Lưu giá theo ngày</button></form></section>
<section class="panel table-panel"><div class="panel-title pricing-toolbar"><h2>Lịch giá</h2><form class="inline-filter pricing-filter" method="get" action="${pageContext.request.contextPath}/manager/pricing"><select name="filterRoomTypeId" aria-label="Lọc theo loại phòng"><option value="0">Tất cả loại phòng</option><c:forEach items="${roomTypes}" var="type"><option value="${type.id}" ${filterRoomTypeId==type.id?'selected':''}><c:out value="${type.typeName}"/></option></c:forEach></select><input type="date" name="filterStartDate" aria-label="Từ ngày" value="${filterStartDate}"><input type="date" name="filterEndDate" aria-label="Đến ngày" value="${filterEndDate}"><button class="secondary-button" type="submit">Xem</button></form></div><c:choose><c:when test="${empty rates}"><div class="empty-state"><h3>Chưa có giá theo ngày</h3><p>Trong khoảng này hệ thống sử dụng giá cơ bản của loại phòng.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Ngày</th><th>Loại phòng</th><th>Giá</th><th>Bán phòng</th></tr></thead><tbody><c:forEach items="${rates}" var="rate"><tr><td>${rate.rateDate}</td><td><c:out value="${rate.roomTypeName}"/></td><td>${rate.nightlyPrice}</td><td><span class="status ${rate.stopSell?'muted':'success'}">${rate.stopSell?'STOP-SELL':'OPEN'}</span></td></tr></c:forEach></tbody></table></div><nav class="pagination rate-pagination"><c:if test="${rateResult.page>1}"><c:url var="previousRatePage" value="/manager/pricing"><c:param name="filterRoomTypeId" value="${filterRoomTypeId}"/><c:param name="filterStartDate" value="${filterStartDate}"/><c:param name="filterEndDate" value="${filterEndDate}"/><c:param name="filterPage" value="${rateResult.page-1}"/></c:url><a href="${previousRatePage}">‹ Trước</a></c:if><span>Trang ${rateResult.page} / ${rateResult.totalPages()} · ${rateResult.totalItems} dòng</span><c:if test="${rateResult.page<rateResult.totalPages()}"><c:url var="nextRatePage" value="/manager/pricing"><c:param name="filterRoomTypeId" value="${filterRoomTypeId}"/><c:param name="filterStartDate" value="${filterStartDate}"/><c:param name="filterEndDate" value="${filterEndDate}"/><c:param name="filterPage" value="${rateResult.page+1}"/></c:url><a href="${nextRatePage}">Sau ›</a></c:if></nav></c:otherwise></c:choose></section></div>
</div></main></div></body></html>
