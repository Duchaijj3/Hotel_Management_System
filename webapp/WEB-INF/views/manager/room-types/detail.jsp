<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết loại phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content narrow-content">
<a class="back-link" href="${pageContext.request.contextPath}/manager/room-types">← Danh sách loại phòng</a><div class="page-heading"><div><h1><c:out value="${item.typeName}"/></h1><p><c:out value="${item.typeCode}"/> · ${item.active?'Đang bán':'Ngừng bán'}</p></div><a class="primary" href="${pageContext.request.contextPath}/manager/room-types/edit?id=${item.id}">Sửa thông tin</a></div>
<c:if test="${not empty sessionScope.flash}"><p class="alert success"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if>
<section class="panel"><dl class="info-list"><dt>Mã</dt><dd><c:out value="${item.typeCode}"/></dd><dt>Sức chứa</dt><dd>${item.maxAdults} người lớn · ${item.maxChildren} trẻ em</dd><dt>Giường</dt><dd><c:out value="${item.bedType}"/></dd><dt>Diện tích</dt><dd>${item.roomSizeM2} m²</dd><dt>Giá cơ bản</dt><dd>${item.basePrice}</dd><dt>Tiện nghi</dt><dd><c:out value="${item.amenities}"/></dd><dt>Mô tả</dt><dd><c:out value="${item.description}"/></dd></dl></section>
<section class="panel action-panel"><h2>Trạng thái bán</h2><p>Deactivate chỉ loại khỏi tìm kiếm/đặt mới; dữ liệu và reservation hiện có được giữ nguyên.</p><form method="post" action="${pageContext.request.contextPath}/manager/room-types/status"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="active" value="${!item.active}"><button class="${item.active?'danger-button':'primary'}" type="submit">${item.active?'Deactivate':'Activate'}</button></form></section>
</div></main></div></body></html>
