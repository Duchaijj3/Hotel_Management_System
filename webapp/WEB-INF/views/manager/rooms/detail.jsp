<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Phòng ${item.roomNumber}</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content narrow-content">
<a class="back-link" href="${pageContext.request.contextPath}/manager/rooms">← Danh sách phòng</a><div class="page-heading"><div><h1>Phòng <c:out value="${item.roomNumber}"/></h1><p><c:out value="${item.typeName}"/> · Tầng ${item.floorNumber}</p></div><a class="primary" href="${pageContext.request.contextPath}/manager/rooms/edit?id=${item.id}">Sửa thông tin</a></div><c:if test="${not empty sessionScope.flash}"><p class="alert success"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if>
<section class="detail-grid"><div class="panel"><dl class="info-list"><dt>Số phòng</dt><dd><c:out value="${item.roomNumber}"/></dd><dt>Loại phòng</dt><dd><c:out value="${item.typeCode}"/> · <c:out value="${item.typeName}"/></dd><dt>Vận hành</dt><dd><c:out value="${item.operationalStatus}"/></dd><dt>Vệ sinh</dt><dd><c:out value="${item.cleaningStatus}"/></dd><dt>Kích hoạt</dt><dd>${item.active?'ACTIVE':'INACTIVE'}</dd><dt>Ghi chú</dt><dd><c:out value="${item.notes}"/></dd></dl></div><aside class="panel action-panel"><h2>Thay đổi vận hành</h2><p>Phòng không ACTIVE + AVAILABLE sẽ không được reserve/assign.</p><form class="stack-form" method="post" action="${pageContext.request.contextPath}/manager/rooms/status"><input type="hidden" name="id" value="${item.id}"><label>Trạng thái<select name="operationalStatus"><option ${item.operationalStatus=='AVAILABLE'?'selected':''}>AVAILABLE</option><option ${item.operationalStatus=='OCCUPIED'?'selected':''}>OCCUPIED</option><option ${item.operationalStatus=='MAINTENANCE'?'selected':''}>MAINTENANCE</option><option ${item.operationalStatus=='OUT_OF_SERVICE'?'selected':''}>OUT_OF_SERVICE</option></select></label><label class="checkbox-field"><input type="checkbox" name="active" value="true" ${item.active?'checked':''}> Active</label><button class="primary" type="submit">Cập nhật trạng thái</button></form></aside></section>
</div></main></div></body></html>
