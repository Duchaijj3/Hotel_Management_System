<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Quản lý phòng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css?v=20260817"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/manager.css?v=20260817"></head><body><div class="app-shell"><%@ include file="../fragments/sidebar.jspf" %><main class="main-panel"><%@ include file="../fragments/header.jspf" %><div class="content">
<div class="page-heading"><div><p class="eyebrow">UC58 · UC59 · BR-16</p><h1>Kho phòng vật lý</h1><p>Trạng thái vận hành được quản lý riêng với vệ sinh và tình trạng lưu trú.</p></div><a class="primary" href="${pageContext.request.contextPath}/manager/rooms/create">Tạo phòng</a></div>
<c:if test="${not empty sessionScope.flash}"><p class="alert success"><c:out value="${sessionScope.flash}"/></p><c:remove var="flash" scope="session"/></c:if>
<section class="panel search-panel"><form class="filters manager-filters" method="get"><label class="grow">Tìm kiếm<input name="keyword" value="<c:out value='${criteria.keyword}'/>" placeholder="Số phòng hoặc loại phòng"></label><label>Loại phòng<select name="roomTypeId"><option value="">Tất cả</option><c:forEach items="${roomTypes}" var="type"><option value="${type.id}" ${criteria.roomTypeId==type.id?'selected':''}><c:out value="${type.typeName}"/></option></c:forEach></select></label><label>Vận hành<select name="operationalStatus"><option value="">Tất cả</option><option ${criteria.operationalStatus=='AVAILABLE'?'selected':''}>AVAILABLE</option><option ${criteria.operationalStatus=='OCCUPIED'?'selected':''}>OCCUPIED</option><option ${criteria.operationalStatus=='MAINTENANCE'?'selected':''}>MAINTENANCE</option><option ${criteria.operationalStatus=='OUT_OF_SERVICE'?'selected':''}>OUT_OF_SERVICE</option></select></label><label>Tầng<input type="number" name="floorNumber" value="${criteria.floorNumber}"></label><label>Kích hoạt<select name="active"><option value="">Tất cả</option><option value="true" ${criteria.active==true?'selected':''}>Active</option><option value="false" ${criteria.active==false?'selected':''}>Inactive</option></select></label><button class="primary" type="submit">Lọc</button></form></section>
<section class="panel table-panel"><div class="panel-title"><h2>Danh sách phòng</h2><span class="count-badge">${result.totalItems} phòng</span></div><c:choose><c:when test="${empty result.items}"><div class="empty-state"><h3>Không có phòng phù hợp</h3><p>Thử thay đổi bộ lọc hoặc tạo phòng mới.</p></div></c:when><c:otherwise><div class="table-wrap"><table><thead><tr><th>Phòng</th><th>Loại</th><th>Tầng</th><th>Vận hành</th><th>Vệ sinh</th><th>Kích hoạt</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${result.items}" var="item"><tr><td><strong><c:out value="${item.roomNumber}"/></strong></td><td><c:out value="${item.typeName}"/></td><td>${item.floorNumber}</td><td><span class="status ${item.operationalStatus=='AVAILABLE'?'success':'muted'}"><c:out value="${item.operationalStatus}"/></span></td><td><c:out value="${item.cleaningStatus}"/></td><td>${item.active?'ACTIVE':'INACTIVE'}</td><td><a class="table-link" href="${pageContext.request.contextPath}/manager/rooms/view?id=${item.id}">Chi tiết</a><a class="table-link" href="${pageContext.request.contextPath}/manager/rooms/edit?id=${item.id}">Sửa</a></td></tr></c:forEach></tbody></table></div><nav class="pagination"><c:if test="${result.page>1}"><a href="?page=${result.page-1}">‹ Trước</a></c:if><span>Trang ${result.page} / ${result.totalPages()}</span><c:if test="${result.page<result.totalPages()}"><a href="?page=${result.page+1}">Sau ›</a></c:if></nav></c:otherwise></c:choose></section>
</div></main></div></body></html>
