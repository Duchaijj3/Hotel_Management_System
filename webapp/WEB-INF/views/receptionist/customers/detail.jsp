<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Customer detail</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css"></head><body><main class="card"><a href="${pageContext.request.contextPath}/receptionist/customers">Back to customers</a><h1><c:out value="${customer.fullName}"/></h1><c:if test="${not empty flash}"><p class="success"><c:out value="${flash}"/></p></c:if><dl><dt>Code</dt><dd><c:out value="${customer.code}"/></dd><dt>Email</dt><dd><c:out value="${customer.email}"/></dd><dt>Phone</dt><dd><c:out value="${customer.phone}"/></dd><dt>Date of birth</dt><dd>${customer.dateOfBirth}</dd><dt>Identification</dt><dd><c:out value="${customer.idType}"/> <c:out value="${customer.idNumber}"/></dd><dt>Nationality</dt><dd><c:out value="${customer.nationality}"/></dd><dt>Address</dt><dd><c:out value="${customer.address}"/></dd><dt>Status</dt><dd><c:out value="${customer.status}"/></dd><dt>Created / Updated</dt><dd>${customer.createdAt} / ${customer.updatedAt}</dd></dl><a class="button" href="edit?id=${customer.id}">Edit</a><h2>Reservation history</h2><table><tr><th>Booking</th><th>Dates</th><th>Status</th><th>Guests</th><th>Total</th><th>Booked</th></tr><c:forEach items="${customer.reservations}" var="x"><tr><td><c:out value="${x.bookingCode}"/></td><td>${x.checkIn} – ${x.checkOut}</td><td><c:out value="${x.status}"/></td><td>${x.adults} / ${x.children}</td><td>${x.total}</td><td>${x.bookedAt}</td></tr></c:forEach></table><h2>Stay history</h2><table><tr><th>Booking</th><th>Actual stay</th><th>Room</th><th>Type</th><th>Assignment</th><th>Current</th></tr><c:forEach items="${customer.stays}" var="x"><tr><td><c:out value="${x.bookingCode}"/></td><td>${x.actualCheckIn} – ${x.actualCheckOut}</td><td><c:out value="${x.roomNumber}"/></td><td><c:out value="${x.roomType}"/></td><td>${x.assignedAt} – ${x.unassignedAt}</td><td>${x.current}</td></tr></c:forEach></table></main></body></html>
