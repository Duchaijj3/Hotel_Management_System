<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Customer form</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css"></head><body><main class="card"><h1>${mode=='create'?'Create walk-in customer':'Update customer'}</h1><c:if test="${not empty errors.general}"><p class="error"><c:out value="${errors.general}"/></p></c:if><form method="post" action="${pageContext.request.contextPath}/receptionist/customers/${mode=='create'?'create':'update'}"><c:if test="${mode=='edit'}"><input type="hidden" name="id" value="${customer.id}"><input type="hidden" name="version" value="${customer.version}"></c:if><div class="grid"><label>Full name *<input name="fullName" maxlength="150" required value="<c:out value='${customer.fullName}'/>"><small><c:out value="${errors.fullName}"/></small></label><label>Email<input type="email" name="email" maxlength="255" value="<c:out value='${customer.email}'/>"><small><c:out value="${errors.email}"/></small></label><label>Phone<input name="phone" maxlength="30" value="<c:out value='${customer.phone}'/>"></label><label>Date of birth<input type="date" name="dateOfBirth" value="${customer.dateOfBirth}"><small><c:out value="${errors.dateOfBirth}"/></small></label><label>Identification type<input name="idDocumentType" maxlength="30" value="<c:out value='${customer.idDocumentType}'/>"></label><label>Identification number<input name="idDocumentNumber" maxlength="50" value="<c:out value='${customer.idDocumentNumber}'/>"><small><c:out value="${errors.idDocumentNumber}"/></small></label><label>Nationality<input name="nationality" maxlength="80" value="<c:out value='${customer.nationality}'/>"></label><label>Address<input name="address" maxlength="255" value="<c:out value='${customer.address}'/>"></label></div><button>Save</button> <a href="${pageContext.request.contextPath}/receptionist/customers">Cancel</a></form></main></body></html>
