<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Customers</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css"></head><body><main class="card"><header><h1>Customers</h1><a class="button" href="${pageContext.request.contextPath}/receptionist/customers/create">Create walk-in customer</a></header><form class="filters"><input name="keyword" value="<c:out value='${criteria.keyword}'/>" placeholder="Name, phone, email, ID or code"><select name="status"><option value="">All statuses</option><option ${criteria.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${criteria.status=='INACTIVE'?'selected':''}>INACTIVE</option></select><button>Search</button></form><c:choose><c:when test="${empty result.items}"><p class="empty">No customers found.</p></c:when><c:otherwise><table><thead><tr><th>Code</th><th>Name</th><th>Phone</th><th>Email</th><th>ID number</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${result.items}" var="x"><tr><td><c:out value="${x.code}"/></td><td><c:out value="${x.fullName}"/></td><td><c:out value="${x.phone}"/></td><td><c:out value="${x.email}"/></td><td><c:out value="${x.idNumber}"/></td><td><c:out value="${x.status}"/></td><td><a href="view?id=${x.id}">View</a> <a href="edit?id=${x.id}">Edit</a></td></tr></c:forEach></tbody></table><nav>Page ${result.page} / ${result.totalPages()} <c:if test="${result.page>1}"><a href="?keyword=${criteria.keyword}&status=${criteria.status}&page=${result.page-1}">Previous</a></c:if> <c:if test="${result.page<result.totalPages()}"><a href="?keyword=${criteria.keyword}&status=${criteria.status}&page=${result.page+1}">Next</a></c:if></nav></c:otherwise></c:choose></main></body></html>
