<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><title>Available rooms</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/receptionist.css"></head><body><main class="card"><h1>Available rooms</h1><form class="filters"><input type="hidden" name="reservationRoomId" value="${reservationRoomId}"><input type="number" name="floor" value="${floor}" placeholder="Floor"><button>Filter</button></form><c:choose><c:when test="${empty rooms}"><p class="empty">No suitable rooms are available.</p></c:when><c:otherwise><p>Requested dates: ${rooms[0].checkIn} – ${rooms[0].checkOut}</p><table><tr><th>Room</th><th>Floor</th><th>Type</th><th>Bed</th><th>Capacity</th><th>Operational</th><th>Cleaning</th></tr><c:forEach items="${rooms}" var="x"><tr><td><c:out value="${x.roomNumber}"/></td><td>${x.floor}</td><td><c:out value="${x.typeCode}"/> — <c:out value="${x.typeName}"/></td><td><c:out value="${x.bedType}"/></td><td>${x.maxAdults} adults / ${x.maxChildren} children</td><td>${x.operationalStatus}</td><td>${x.cleaningStatus}</td></tr></c:forEach></table></c:otherwise></c:choose></main></body></html>
